# Preproduction contract.
# Copy values into the GitHub "preproduction" environment and your secret manager.
# Do not commit real credentials.

ENV=production
LOG_LEVEL=INFO
ACCESS_TOKEN_EXPIRE_MINUTES=30
VAELQORIX_PUBLIC_REGISTRATION_ENABLED=false
ENTERPRISE_TENANT_MODE=strict

# Managed Postgres
POSTGRES_HOST=preproduc-postgres.example.internal
POSTGRES_PORT=5432
POSTGRES_DB=vaelqorix_preproduc
POSTGRES_USER=vaelqorix_preproduc
POSTGRES_PASSWORD=SET_IN_SECRET_MANAGER

# Managed Redis
REDIS_URL=rediss://preproduc-redis.example.internal:6380/0
REDIS_KEY_PREFIX=vaelqorix:preproduc
RATE_LIMIT_BACKEND=redis
REPLAY_GUARD_BACKEND=redis
ARES_KILL_SWITCH_BACKEND=redis
ARES_KILL_SWITCH_KEY=ares:kill_switch

# Runtime secrets mounted by the cluster secret manager
SECRET_BACKEND=file
SECRET_FILE_DIR=/run/secrets/aresx
SECRET_KEY=SET_IN_SECRET_MANAGER
VAELQORIX_MONITOR_TOKEN=SET_IN_SECRET_MANAGER
ACTION_SHARED_TOKEN=SET_IN_SECRET_MANAGER

# Public edge
PREPRODUCTION_HOSTNAME=preproduc.vaelqorix.example
CORS_ORIGINS=["https://preproduc.vaelqorix.example"]

# Observability
PROMETHEUS_BASE=https://prometheus-preproduc.example.internal
ALERTMANAGER_BASE=https://alertmanager-preproduc.example.internal
ALERTMANAGER_ALLOWED_CIDRS=10.0.0.0/8

# RedQueen / AI / vector context
AI_ENABLED=true
AI_PROVIDER=azure_openai
AI_BASE_URL=https://preproduc-ai-gateway.example.com
AI_MODEL=gpt-5-mini
AI_TIMEOUT_SEC=8
AI_TEMPERATURE=0.1
MCP_CONTEXT_ENABLED=true
MCP_CONTEXT_MODE=external_mcp
VECTOR_STORE_ENABLED=true
VECTOR_STORE_PROVIDER=qdrant
VECTOR_COLLECTION_PREFIX=vaelqorix_preproduc

# ARES execution plane
ACTION_EXECUTION_MODE=webhook
ACTION_TIMEOUT_SEC=5
NETWORK_CONTROL_URL=https://network-control-preproduc.example.com
DNS_FIREWALL_CONTROL_URL=https://dns-firewall-preproduc.example.com
IDENTITY_CONTROL_URL=https://identity-control-preproduc.example.com
ENDPOINT_CONTROL_URL=https://endpoint-control-preproduc.example.com
SOAR_CONTROL_URL=https://soar-preproduc.example.com
DEVSECOPS_CONTROL_URL=https://devsecops-preproduc.example.com

# First pilot integrations
ENTRA_GRAPH_ENABLED=true
ENTRA_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
ENTRA_GRAPH_SCOPE=https://graph.microsoft.com/.default
ENTRA_TENANT_ID=SET_IN_GITHUB_ENVIRONMENT
ENTRA_CLIENT_ID=SET_IN_GITHUB_ENVIRONMENT
ENTRA_CLIENT_SECRET=SET_IN_SECRET_MANAGER
ENTRA_WEBHOOK_SECRET=SET_IN_SECRET_MANAGER
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TOKEN=SET_IN_SECRET_MANAGER
GITHUB_DEFAULT_OWNER=SET_IN_GITHUB_ENVIRONMENT
GITHUB_TOKEN_SECRET_NAMES=GITHUB_TOKEN
SOC_WEBHOOK_URL=https://soc-preproduc.example.com/events
SOC_WEBHOOK_TOKEN=SET_IN_SECRET_MANAGER
SOC_WEBHOOK_HMAC_SECRET=SET_IN_SECRET_MANAGER

# Disabled in preproduction unless a broker is explicitly provisioned.
KAFKA_INGESTION_ENABLED=false
