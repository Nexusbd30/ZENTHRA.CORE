# =============================================================
# 🔐 Seguridad
# =============================================================
SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOG_LEVEL=INFO
ENV=production
VAELQORIX_PUBLIC_REGISTRATION_ENABLED=false

# =============================================================
# 🗄️ Base de datos
# =============================================================

# (A) SIMPLE: URI directo
# SQLALCHEMY_DATABASE_URI=sqlite:///./app.db
# SQLALCHEMY_DATABASE_URI=postgresql+psycopg://vaelqorix:vaelqorix@127.0.0.1:5432/vaelqorix

# (B) PRO: construir URI automáticamente con POSTGRES_*
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=56432
VAELQORIX_POSTGRES_PORT=56432
POSTGRES_DB=vaelqorix
POSTGRES_USER=vaelqorix
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# =============================================================
# 🌐 CORS
# =============================================================
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]'

# =============================================================
# 🛡️ Token interno monitorización
# =============================================================
VAELQORIX_MONITOR_TOKEN=CHANGE_ME_MONITOR_TOKEN
RATE_LIMIT_BACKEND=redis
REPLAY_GUARD_BACKEND=redis
ARES_KILL_SWITCH_BACKEND=redis
ARES_KILL_SWITCH_KEY=ares:kill_switch
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=vaelqorix
SECRET_BACKEND=file
SECRET_FILE_DIR=/run/secrets

# =============================================================
# 🔔 Observabilidad
# =============================================================
PROMETHEUS_BASE=http://127.0.0.1:9090
ALERTMANAGER_BASE=http://127.0.0.1:9093
ALERTMANAGER_ALLOWED_CIDRS=172.20.0.0/16,127.0.0.1/32,::1/128
PROM_TIMEOUT_SEC=2
PROM_CACHE_TTL_SECONDS=5
PROMETHEUS_MONITOR_TOKEN_FILE=./secrets/vaelqorix_monitor_token

# =============================================================
# 🧠 Correlation Scheduler
# =============================================================
VAELQORIX_CORRELATION_ENABLED=true
VAELQORIX_CORRELATION_INTERVAL_SEC=60
VAELQORIX_CORRELATION_STARTUP_DELAY_SEC=5
VAELQORIX_ENABLE_LAB_ALERTS=false
# =============================================================
# AI / LLM (RedQueen)
# =============================================================
AI_ENABLED=true
AI_PROVIDER=ollama
AI_MODEL=llama3.1:8b
AI_BASE_URL=https://CHANGE_ME_LLM_GATEWAY
AI_TIMEOUT_SEC=8
MCP_CONTEXT_ENABLED=true
MCP_CONTEXT_MODE=manual_context
VECTOR_STORE_ENABLED=true
VECTOR_STORE_PROVIDER=qdrant
VECTOR_DIMENSIONS=64
VECTOR_COLLECTION_PREFIX=vaelqorix
KAFKA_INGESTION_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_INGESTION_TOPICS=vaelqorix.siem,vaelqorix.edr,vaelqorix.iam,vaelqorix.netflow
KAFKA_CONSUMER_GROUP_ID=vaelqorix-core-ingestion
KAFKA_AUTO_OFFSET_RESET=latest
KAFKA_POLL_TIMEOUT_SEC=1
REDQUEEN_AUTONOMY_MAX=80
REDQUEEN_HUMAN_APPROVAL_SCORE=80
ACTION_EXECUTION_MODE=webhook
ACTION_TIMEOUT_SEC=5
ACTION_SHARED_TOKEN=CHANGE_ME_ACTION_SHARED_TOKEN
NETWORK_CONTROL_URL=
DNS_FIREWALL_CONTROL_URL=
IDENTITY_CONTROL_URL=
ENTRA_GRAPH_ENABLED=false
ENTRA_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
ENTRA_GRAPH_TOKEN_URL=
ENTRA_GRAPH_SCOPE=https://graph.microsoft.com/.default
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REQUIRE_MFA_POLICY_URL=
ENTRA_DEGRADE_PRIVILEGES_GROUP_IDS=
ENTRA_WEBHOOK_SECRET=CHANGE_ME_ENTRA_WEBHOOK_SECRET
ENTRA_WEBHOOK_MAX_SKEW_SEC=300
ENTRA_WEBHOOK_RATE_LIMIT_ENABLED=true
ENTRA_WEBHOOK_RATE_LIMIT_REQUESTS=120
ENTRA_WEBHOOK_RATE_LIMIT_WINDOW_SEC=60
ENTRA_WEBHOOK_REPLAY_GUARD_ENABLED=true
ENTRA_WEBHOOK_REPLAY_TTL_SEC=300
ENDPOINT_CONTROL_URL=
SOAR_CONTROL_URL=
CRYPTO_CONTROL_URL=
SOC_WEBHOOK_URL=
SOC_WEBHOOK_TOKEN=
SOC_WEBHOOK_HMAC_SECRET=
SOC_WEBHOOK_TIMEOUT_SEC=5
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TOKEN=
GITHUB_DEFAULT_OWNER=
GITHUB_TOKEN_SECRET_NAMES=
AI_TEMPERATURE=0.1

# Bootstrap admin local. No hay password por defecto.
BOOTSTRAP_ADMIN_EMAIL=admin@vaelqorix.dev
BOOTSTRAP_ADMIN_PASSWORD=
